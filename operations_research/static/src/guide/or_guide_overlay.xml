<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="operations_research.GuideOverlay">
        <div t-if="state.active" class="o_or_guide" t-att-class="{'o_or_guide_centered': !layout.hole}">
            <div t-if="layout.hole" class="o_or_guide_hole" t-att-style="layout.hole"/>
            <div t-else="" class="o_or_guide_backdrop"/>
            <div class="o_or_guide_bubble card shadow-lg" t-att-style="layout.hole ? layout.bubble : ''"
                 role="dialog" aria-live="polite">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center mb-1">
                        <span class="badge text-bg-primary o_or_guide_counter">
                            <t t-out="state.index + 1"/> / <t t-out="state.steps.length"/>
                        </span>
                        <span class="text-muted small ms-2 text-truncate" t-out="state.name"/>
                        <button class="btn btn-link btn-sm ms-auto p-0 text-muted o_or_guide_close"
                                t-on-click="() => this.guide.stop()" title="Close">
                            <i class="fa fa-times"/>
                        </button>
                    </div>
                    <h5 class="mb-1 o_or_guide_title" t-out="step.title"/>
                    <p class="mb-3 o_or_guide_text" t-out="step.text"/>
                    <div t-if="state.busy" class="text-muted small mb-2"><i class="fa fa-circle-o-notch fa-spin me-1"/>Loading…</div>
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-sm btn-secondary o_or_guide_back" t-att-disabled="state.index === 0 or state.busy"
                                t-on-click="() => this.guide.back()">Back</button>
                        <button t-attf-class="btn btn-sm #{state.autoplay ? 'btn-warning' : 'btn-outline-primary'} o_or_guide_play"
                                t-on-click="() => this.guide.toggleAutoplay()">
                            <i t-attf-class="fa #{state.autoplay ? 'fa-pause' : 'fa-play'} me-1"/>
                            <t t-if="state.autoplay">Pause</t><t t-else="">Auto-play</t>
                        </button>
                        <button t-if="!isLast" class="btn btn-sm btn-primary ms-auto o_or_guide_next"
                                t-att-disabled="state.busy" t-on-click="() => this.guide.next()">Next</button>
                        <button t-else="" class="btn btn-sm btn-success ms-auto o_or_guide_finish"
                                t-on-click="() => this.guide.stop()">Finish</button>
                    </div>
                </div>
                <div t-if="state.autoplay and !state.busy" class="o_or_guide_progress" t-key="state.token + '_' + state.index">
                    <div t-att-style="progressStyle"/>
                </div>
            </div>
        </div>
    </t>
</templates>
