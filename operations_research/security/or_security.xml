<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_operations_research" model="ir.module.category">
        <field name="name">Operations Research</field>
        <field name="sequence">60</field>
    </record>

    <record id="res_groups_privilege_or" model="res.groups.privilege">
        <field name="name">Operations Research</field>
        <field name="sequence">50</field>
        <field name="category_id" ref="module_category_operations_research"/>
    </record>

    <record id="group_or_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_or"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Runs existing optimization problems and reviews the results.</field>
    </record>

    <record id="group_or_designer" model="res.groups">
        <field name="name">Designer</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_or"/>
        <field name="implied_ids" eval="[(4, ref('group_or_user'))]"/>
        <field name="comment">Creates and configures optimization problems and scenarios.</field>
    </record>

    <record id="group_or_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_or"/>
        <field name="implied_ids" eval="[(4, ref('group_or_designer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Applies results to records and manages settings.</field>
    </record>

</odoo>
