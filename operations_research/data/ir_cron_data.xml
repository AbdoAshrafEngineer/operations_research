<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_or_process_queue" model="ir.cron">
        <field name="name">Operations Research: Solve Queued Runs</field>
        <field name="model_id" ref="model_or_run"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="priority">5</field>
    </record>
    <record id="ir_cron_or_scheduled_problems" model="ir.cron">
        <field name="name">Operations Research: Scheduled Problems</field>
        <field name="model_id" ref="model_or_problem"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_scheduled()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="priority">10</field>
    </record>
</odoo>
