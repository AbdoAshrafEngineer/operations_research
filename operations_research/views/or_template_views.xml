<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="or_template_view_kanban" model="ir.ui.view">
        <field name="name">or.template.kanban</field>
        <field name="model">or.template</field>
        <field name="arch" type="xml">
            <kanban create="false" group_create="false" records_draggable="false" class="o_or_template_kanban">
                <field name="is_available"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <field name="name" class="fw-bold fs-5"/>
                            <span class="badge rounded-pill text-bg-light"><field name="app_name"/></span>
                        </div>
                        <field name="summary" class="text-muted mt-1"/>
                        <div t-if="!record.is_available.raw_value" class="alert alert-warning py-1 px-2 mt-2 mb-0 small" role="status">
                            <field name="missing_info"/>
                        </div>
                        <div t-elif="record.missing_info.raw_value" class="small text-warning mt-2">
                            <i class="fa fa-exclamation-triangle me-1" title="Needs"/>
                            <span>Needs: </span><field name="missing_info"/>
                        </div>
                        <footer class="mt-2">
                            <button name="action_use" type="object" class="btn btn-primary btn-sm"
                                    invisible="not is_available" groups="operations_research.group_or_designer">
                                Use this template
                            </button>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="or_template_view_list" model="ir.ui.view">
        <field name="name">or.template.list</field>
        <field name="model">or.template</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="problem_type"/>
                <field name="app_name"/>
                <field name="is_available"/>
                <button name="action_use" type="object" string="Use" icon="fa-magic"
                        invisible="not is_available" groups="operations_research.group_or_designer"/>
            </list>
        </field>
    </record>

    <record id="or_template_view_form" model="ir.ui.view">
        <field name="name">or.template.form</field>
        <field name="model">or.template</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_use" type="object" string="Use this template" class="btn-primary"
                            invisible="not is_available" groups="operations_research.group_or_designer"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="problem_type"/>
                            <field name="app_name"/>
                            <field name="is_available"/>
                        </group>
                        <group>
                            <field name="missing_info" invisible="not missing_info"/>
                        </group>
                    </group>
                    <field name="summary"/>
                    <separator string="Before solving"/>
                    <field name="next_steps"/>
                    <group groups="base.group_no_one">
                        <field name="model_name"/>
                        <field name="config" widget="ace" options="{'mode': 'json'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="or_template_view_search" model="ir.ui.view">
        <field name="name">or.template.search</field>
        <field name="model">or.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="app_name"/>
                <filter name="type_lp" string="How much?" domain="[('problem_type', '=', 'lp')]"/>
                <filter name="type_assignment" string="Who does what?" domain="[('problem_type', '=', 'assignment')]"/>
                <filter name="type_scheduling" string="When?" domain="[('problem_type', '=', 'scheduling')]"/>
                <filter name="type_routing" string="Which route?" domain="[('problem_type', '=', 'routing')]"/>
                <group>
                    <filter name="group_type" string="Question" context="{'group_by': 'problem_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="or_template_action" model="ir.actions.act_window">
        <field name="name">Start from a Template</field>
        <field name="res_model">or.template</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_group_type': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No template yet</p>
            <p>Templates are ready-made problems for common decisions: pick one, check the
               highlighted fields and solve.</p>
        </field>
    </record>

    <record id="or_setup_check_view_form" model="ir.ui.view">
        <field name="name">or.setup.check.form</field>
        <field name="model">or.setup.check</field>
        <field name="arch" type="xml">
            <form string="Check Setup">
                <div class="alert alert-success mb-2" role="status" invisible="not is_ready or warning_count">
                    <i class="fa fa-check-circle me-1" title="Ready"/> Everything needed is in place.
                </div>
                <div class="alert alert-warning mb-2" role="status" invisible="not is_ready or not warning_count">
                    <i class="fa fa-exclamation-triangle me-1" title="Check"/> You can solve, but check the items below.
                </div>
                <div class="alert alert-danger mb-2" role="alert" invisible="is_ready">
                    <i class="fa fa-times-circle me-1" title="Fix"/> Fix the items marked "Must fix" before solving.
                </div>
                <field name="line_ids" readonly="1" nolabel="1">
                    <list create="false" delete="false" decoration-danger="level == 'blocker'"
                          decoration-warning="level == 'warning'" decoration-muted="level == 'info'"
                          decoration-success="level == 'ok'">
                        <field name="level" widget="badge" decoration-danger="level == 'blocker'"
                               decoration-warning="level == 'warning'" decoration-info="level == 'info'"
                               decoration-success="level == 'ok'"/>
                        <field name="message"/>
                    </list>
                </field>
                <footer>
                    <button name="action_solve" type="object" string="Solve" class="btn-primary"
                            invisible="not is_ready"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
